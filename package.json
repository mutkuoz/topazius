{
  "name": "topazius",
  "version": "1.0.0",
  "description": "A browser-only markdown notes app with no backend, storing notes as files in a private GitHub repository you own.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutkuoz/topazius.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "private": true,
  "bugs": {
    "url": "https://github.com/mutkuoz/topazius/issues"
  },
  "homepage": "https://github.com/mutkuoz/topazius#readme",
  "dependencies": {
    "idb": "^8.0.3",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^26.4.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.10",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
