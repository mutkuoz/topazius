{
  "name": "topazius",
  "version": "1.0.0",
  "description": "A browser-only markdown notes app with no backend, storing notes as files in a private GitHub repository you own.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mutkuoz/topazius.git"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "private": true,
  "bugs": {
    "url": "https://github.com/mutkuoz/topazius/issues"
  },
  "homepage": "https://github.com/mutkuoz/topazius#readme",
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "codemirror": "^6.0.2",
    "dompurify": "^3.4.14",
    "idb": "^8.0.3",
    "markdown-it": "^14.3.0",
    "minisearch": "^7.2.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.6",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.4.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.10",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
